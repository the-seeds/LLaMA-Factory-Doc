#: 374613c22acf4c22a4b6c40176a79c7e
msgid "``pip install -r requirements/bitsandbytes.txt``"
msgstr "``pip install -r requirements/bitsandbytes.txt``"

#: ../../source/multibackend/xpu/xpu_installation.rst:118
#: 4c44b273d2754215a31c4416c15b1aef
msgid "GPTQ / AWQ"
msgstr "GPTQ / AWQ"

#: ../../source/multibackend/xpu/xpu_installation.rst:119
#: 43119827e0794f1ea438f01acadb9680
msgid ""
"``pip install \"gptqmodel==7.2.0\" optimum``。更新的 gptqmodel 版本需要高于 "
"LlamaFactory 所支持的 transformers 版本。加载 AWQ 模型还需执行 ``pip install --no-deps "
"autoawq``。"
msgstr ""
"``pip install \"gptqmodel==7.2.0\" optimum``. Newer gptqmodel versions "
"require a newer transformers than LlamaFactory supports. Loading AWQ "
"models additionally requires ``pip install --no-deps autoawq``."

#: ../../source/multibackend/xpu/xpu_installation.rst:120
#: 435df4f604e74a3a8dabf76800ae0922
msgid "Liger Kernel"
msgstr "Liger Kernel"

#: ../../source/multibackend/xpu/xpu_installation.rst:121
#: 15a9e92a87d24643bedf749b4eace152
msgid ""
"``pip install --no-deps liger-kernel``。请务必加上 ``--no-deps``，详见 "
":ref:`xpu_faq`。"
msgstr ""
"``pip install --no-deps liger-kernel``. Always add ``--no-deps``; see "
":ref:`xpu_faq`."

#: ../../source/multibackend/xpu/xpu_installation.rst:122
#: 40c7e1c0828a4d098910675b4d5c2881
